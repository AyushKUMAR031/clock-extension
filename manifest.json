{
  "manifest_version": 3,
  "name": "Aesthetic Tabs",
  "version": "2.0",
  "description": "Aesthetic new tab with clock, weather and quick tools.",

  "permissions": ["storage", "geolocation"],

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Clock Extension Settings"
  },

  "icons": {
    "16": "public/assets/icon.png",
    "48": "public/assets/icon.png",
    "128": "public/assets/icon.png"
  }
}
